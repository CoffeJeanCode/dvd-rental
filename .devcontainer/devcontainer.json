{
  "name": "DVD Rental - Campaña de Halloween (PL/pgSQL)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "shutdownAction": "stopCompose",
  "forwardPorts": [5432],
  "portsAttributes": {
    "5432": { "label": "PostgreSQL dvdrental" }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends postgresql-client && chmod +x ejecutar_todo.sh",
  "postAttachCommand": "echo 'Listo: ejecuta  bash ejecutar_todo.sh   o abre una consola con  psql'",
  "customizations": {
    "vscode": {
      "extensions": [
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg"
      ],
      "settings": {
        "sqltools.connections": [
          {
            "name": "dvdrental",
            "driver": "PostgreSQL",
            "server": "localhost",
            "port": 5432,
            "database": "dvdrental",
            "username": "postgres",
            "password": "postgres"
          }
        ]
      }
    }
  }
}
